@model OCMSMVC.Models.WalkInViewModel
@{
    ViewData["Title"] = "Đăng Ký Khám Vãng Lai";
    var doctors = ViewBag.Doctors as List<BusinessObjects.Entities.Doctor> ?? new List<BusinessObjects.Entities.Doctor>();
}

<div class="container py-4" style="max-width: 820px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-person-plus-fill me-2"></i>Tiếp Đón Bệnh Nhân Vãng Lai (Walk-in)
            </h3>
            <p class="text-muted mb-0">Đăng ký bệnh nhân chưa hẹn trước tại quầy và gán vào khung giờ trống (Filler slot) hoặc ca khẩn cấp.</p>
        </div>
        <a asp-action="CheckIn" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Về Trang Check-in
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <h6 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Đăng ký không thành công:</h6>
            <div asp-validation-summary="All" class="text-danger mb-0 small"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-primary bg-gradient text-white py-3 px-4">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-person-vcard me-2"></i>Thông Tin Bệnh Nhân & Điều Phối Phòng Khám
            </h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="WalkIn" method="post" id="walkInForm">
                @Html.AntiForgeryToken()

                <!-- Khối thông tin bệnh nhân -->
                <h6 class="fw-bold text-secondary text-uppercase mb-3">1. Thông tin cá nhân</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold">Họ và tên bệnh nhân <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn Bình" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Ví dụ: 0912345678" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        <small class="text-muted">Hệ thống tự nhận diện nếu bệnh nhân từng khám trước đó.</small>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Gender" class="form-label fw-semibold">Giới tính</label>
                        <select asp-for="Gender" class="form-select">
                            <option value="Male">Nam</option>
                            <option value="Female">Nữ</option>
                            <option value="Other">Khác</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DateOfBirth" class="form-label fw-semibold">Ngày sinh <span class="text-danger">*</span></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" required />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Address" class="form-label fw-semibold">Địa chỉ / Tỉnh thành</label>
                        <input asp-for="Address" class="form-control" placeholder="Hà Nội, TP.HCM..." />
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Khối gán Bác sĩ & Slot -->
                <h6 class="fw-bold text-secondary text-uppercase mb-3">2. Phân bổ Bác sĩ & Khung giờ khám (Slot)</h6>
                
                <!-- Tùy chọn khẩn cấp / Cấp cứu -->
                <div class="form-check form-switch p-3 bg-danger-subtle rounded-3 mb-3 border border-danger">
                    <input asp-for="IsEmergency" class="form-check-input ms-0 me-3" type="checkbox" id="emergencySwitch" style="width: 2.5em; height: 1.25em;">
                    <label class="form-check-label fw-bold text-danger" for="emergencySwitch">
                        <i class="bi bi-shield-fill-exclamation me-1"></i> Tiếp nhận CẤP CỨU / Khẩn cấp (Emergency Slot)
                    </label>
                    <small class="text-danger d-block mt-1">Bật chế độ này sẽ tự động cấp một slot khẩn cấp ngay bây giờ và đưa bệnh nhân vào hàng đợi ưu tiên của bác sĩ.</small>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="DoctorId" class="form-label fw-semibold">Chọn Bác sĩ phụ trách <span class="text-danger">*</span></label>
                        <select asp-for="DoctorId" class="form-select form-select-lg" id="doctorSelect" required>
                            <option value="">-- Chọn bác sĩ có lịch hôm nay --</option>
                            @foreach (var doc in doctors)
                            {
                                var sched = doc.Schedules.FirstOrDefault(s => s.WorkDate.Date == DateTime.Today);
                                var roomNum = sched?.Room?.RoomNumber ?? "101";
                                <option value="@doc.Id">
                                    @(doc.AcademicTitle) @(doc.User?.FullName) - @(doc.Department?.Name) (Phòng @roomNum)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="DoctorId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6" id="slotContainer">
                        <label asp-for="TimeSlotId" class="form-label fw-semibold">Khung giờ trống còn lại (Filler Slot)</label>
                        <select asp-for="TimeSlotId" class="form-select form-select-lg" id="timeSlotSelect">
                            <option value="">-- Vui lòng chọn bác sĩ trước --</option>
                        </select>
                        <span asp-validation-for="TimeSlotId" class="text-danger small"></span>
                        <small class="text-muted" id="slotHint">Hệ thống tự động lọc các khung giờ chưa có người đặt hôm nay.</small>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Reason" class="form-label fw-semibold">Triệu chứng ban đầu / Lý do đến khám</label>
                    <textarea asp-for="Reason" class="form-control" rows="2" placeholder="Ví dụ: Đau đầu dữ dội, sốt cao 39 độ cần khám gấp..."></textarea>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="CheckIn" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary btn-lg fw-bold px-4 py-2 shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Hoàn Tất Đăng Ký & Nhận Số Khám
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const doctorSelect = document.getElementById('doctorSelect');
    const timeSlotSelect = document.getElementById('timeSlotSelect');
    const slotContainer = document.getElementById('slotContainer');
    const emergencySwitch = document.getElementById('emergencySwitch');
    const slotHint = document.getElementById('slotHint');

    function toggleEmergencyMode() {
        if (emergencySwitch.checked) {
            slotContainer.style.opacity = '0.5';
            timeSlotSelect.disabled = true;
            timeSlotSelect.required = false;
            slotHint.innerText = 'Đang bật chế độ Cấp Cứu: Slot khẩn cấp sẽ được tự động kích hoạt.';
        } else {
            slotContainer.style.opacity = '1';
            timeSlotSelect.disabled = false;
            timeSlotSelect.required = true;
            slotHint.innerText = 'Hệ thống tự động lọc các khung giờ chưa có người đặt hôm nay.';
            loadDoctorSlots();
        }
    }

    emergencySwitch.addEventListener('change', toggleEmergencyMode);

    function loadDoctorSlots() {
        const doctorId = doctorSelect.value;
        if (!doctorId) {
            timeSlotSelect.innerHTML = '<option value="">-- Vui lòng chọn bác sĩ trước --</option>';
            return;
        }

        if (emergencySwitch.checked) return;

        timeSlotSelect.innerHTML = '<option value="">Đang tải các khung giờ trống...</option>';

        fetch(`/Reception/GetDoctorSlots?doctorId=${doctorId}`)
            .then(res => res.json())
            .then(slots => {
                if (!slots || slots.length === 0) {
                    timeSlotSelect.innerHTML = '<option value="">Hết slot trống thường hôm nay! (Gợi ý: Bật công tắc Cấp Cứu ở trên)</option>';
                    return;
                }

                let html = '<option value="">-- Chọn khung giờ trống --</option>';
                slots.forEach(s => {
                    html += `<option value="${s.id}">Slot: ${s.time} (Phòng ${s.roomNumber})</option>`;
                });
                timeSlotSelect.innerHTML = html;
            })
            .catch(err => {
                timeSlotSelect.innerHTML = '<option value="">Lỗi khi tải khung giờ.</option>';
            });
    }

    doctorSelect.addEventListener('change', loadDoctorSlots);

    // Initial check
    if (doctorSelect.value) {
        loadDoctorSlots();
    }
</script>
}

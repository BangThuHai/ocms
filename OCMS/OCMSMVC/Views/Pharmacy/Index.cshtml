@model IReadOnlyList<BusinessObjects.Entities.Appointment>
@{
    ViewData["Title"] = "Quầy phát thuốc";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><p class="text-uppercase text-primary fw-semibold small mb-1">Dược lâm sàng</p><h1 class="h3 mb-0">Đơn thuốc chờ phát</h1></div>
    <a class="btn btn-outline-primary" asp-controller="Billing" asp-action="Index"><i class="bi bi-receipt me-1"></i>Quầy thu ngân</a>
</div>
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }

<div class="card border-0 shadow-sm"><div class="table-responsive">
<table class="table align-middle mb-0">
    <thead class="table-light"><tr><th>Lượt khám</th><th>Bệnh nhân</th><th>Bác sĩ</th><th>Thuốc chờ phát</th><th></th></tr></thead>
    <tbody>
    @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-5">Không có đơn thuốc đã thanh toán đang chờ phát.</td></tr> }
    else
    {
        @foreach (var appointment in Model)
        {
            var count = appointment.MedicalRecord!.PrescriptionDetails.Count(line => line.Status == "Paid");
            <tr><td class="fw-semibold">#@appointment.Id</td><td>@appointment.Patient.User.FullName</td><td>@appointment.Doctor.AcademicTitle @appointment.Doctor.User.FullName</td><td>@count dòng</td><td class="text-end"><a class="btn btn-primary btn-sm" asp-action="Order" asp-route-id="@appointment.Id">Xem đơn thuốc</a></td></tr>
        }
    }
    </tbody>
</table>
</div></div>

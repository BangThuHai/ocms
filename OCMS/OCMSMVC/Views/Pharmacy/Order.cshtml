@model BusinessObjects.Entities.Appointment
@{
    ViewData["Title"] = "Xác nhận phát thuốc";
    var paidLines = Model.MedicalRecord!.PrescriptionDetails.Where(line => line.Status == "Paid").ToList();
    var alreadyDispensed = paidLines.Count == 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><p class="text-uppercase text-primary fw-semibold small mb-1">Nhà thuốc · Lượt #@Model.Id</p><h1 class="h3 mb-0">Bàn giao thuốc</h1></div>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại hàng chờ</a>
</div>
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="card border-0 shadow-sm mb-4"><div class="card-body">
    <div class="row"><div class="col-md-6"><div class="text-muted small">Bệnh nhân</div><strong>@Model.Patient.User.FullName</strong><div>@Model.Patient.User.PhoneNumber</div></div><div class="col-md-6"><div class="text-muted small">Bác sĩ kê đơn</div><strong>@Model.Doctor.AcademicTitle @Model.Doctor.User.FullName</strong></div></div>
</div></div>

<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0">
    <thead class="table-light"><tr><th>Thuốc</th><th>Số lượng</th><th>Hướng dẫn sử dụng</th><th>Trạng thái</th></tr></thead>
    <tbody>
    @foreach (var line in Model.MedicalRecord!.PrescriptionDetails)
    {
        <tr><td>@line.Medicine.Name<br /><small class="text-muted">Đơn vị: @line.Medicine.Unit</small></td><td>@line.Quantity</td><td>@line.DosageInstruction</td><td><span class="badge @(line.Status == "Paid" ? "text-bg-success" : "text-bg-secondary")">@line.Status</span></td></tr>
    }
    </tbody>
</table></div>
<div class="card-body d-flex justify-content-between align-items-center">
    <span class="text-muted small">Xác nhận sẽ trừ kho trong một giao dịch. Không thể phát lặp lại các dòng thuốc đã bàn giao.</span>
    @if (!alreadyDispensed)
    {
        <form asp-action="Dispense" method="post" onsubmit="return confirm('Xác nhận đã bàn giao toàn bộ thuốc và trừ tồn kho?');">
            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-primary">Xác nhận đã phát</button>
        </form>
    }
    else { <span class="badge text-bg-secondary">Đơn đã phát xong</span> }
</div></div>

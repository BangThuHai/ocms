@model OCMSMVC.Models.RescheduleViewModel
@{
    ViewData["Title"] = "Đổi Lịch Khám";
    var docName = Model.DoctorName;
    if (!string.IsNullOrEmpty(Model.AcademicTitle) && docName.StartsWith("BS.", StringComparison.OrdinalIgnoreCase))
    {
        docName = docName.Substring(3).Trim();
    }
    var docFullTitle = string.IsNullOrEmpty(Model.AcademicTitle) ? docName : $"{Model.AcademicTitle} {docName}";
}

<div class="container py-4">
    <div class="card border-1 mb-4 bg-primary text-white">
        <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <a asp-action="MyAppointments" class="btn btn-sm btn-light mb-2"><i class="bi bi-arrow-left"></i> Quay lại lịch hẹn</a>
                <h3 class="fw-bold mb-1">Đổi Lịch Khám: @docFullTitle</h3>
                <p class="opacity-75 mb-0">
                    Chuyên khoa: @Model.DepartmentName | Phòng @Model.RoomNumber | Khung giờ hiện tại: <strong>@Model.CurrentAppointmentDate.ToString("dd/MM/yyyy") (@Model.CurrentStartTime.ToString(@"hh\:mm") - @Model.CurrentEndTime.ToString(@"hh\:mm"))</strong>
                </p>
            </div>
            <div class="text-end">
                <span class="badge bg-white text-primary">Lượt đổi: @Model.RescheduledCount / 1</span>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-1 py-2 mb-4" role="alert">
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-1 mb-4">
        <div class="card-body p-3 d-flex align-items-center justify-content-between flex-wrap gap-3">
            <form method="get" asp-action="Reschedule" class="d-flex align-items-center gap-2 flex-wrap mb-0">
                <input type="hidden" name="id" value="@Model.AppointmentId" />
                <label class="fw-semibold text-dark mb-0">Chọn ngày khám mới:</label>
                <input type="date" name="date" class="form-control form-control-sm" style="max-width: 180px;"
                       value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       max="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")"
                       onchange="this.form.submit()" />
            </form>
            <div class="text-muted small">
                Tải: <span class="badge @Model.DayCapacity.BadgeClass">@Model.DayCapacity.StatusText</span> (Còn trống: <strong class="text-success">@Model.DayCapacity.AvailableSlots</strong> slot)
            </div>
        </div>
    </div>

    <form asp-action="ConfirmReschedule" method="post" id="rescheduleForm">
        <input type="hidden" name="AppointmentId" value="@Model.AppointmentId" />
        <input type="hidden" name="NewSlotId" id="selectedNewSlotId" value="" />

        <div class="row g-4">
            <!-- Ca sáng -->
            <div class="col-md-6">
                <div class="card border-1 h-100">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="fw-bold text-primary mb-0">Ca sáng (07:30 - 11:30)</h5>
                    </div>
                    <div class="card-body pt-0">
                        @if (Model.MorningSlots.Count == 0)
                        {
                            <p class="text-muted small py-2">Không có ca khám buổi sáng trong ngày này.</p>
                        }
                        else
                        {
                            <div class="row g-2">
                                @foreach (var slot in Model.MorningSlots)
                                {
                                    bool isCurrentSlot = slot.SlotId == Model.CurrentSlotId && Model.SelectedDate.Date == Model.CurrentAppointmentDate.Date;
                                    string btnClass;
                                    string labelText;
                                    bool isClickable;

                                    if (isCurrentSlot)
                                    {
                                        btnClass = "btn-outline-info disabled";
                                        labelText = "Slot hiện tại";
                                        isClickable = false;
                                    }
                                    else if (slot.Status == "Open")
                                    {
                                        btnClass = "btn-outline-success";
                                        labelText = "Còn trống";
                                        isClickable = true;
                                    }
                                    else if (slot.Status == "Hold")
                                    {
                                        btnClass = "btn-light text-muted border disabled";
                                        labelText = "Đang giữ";
                                        isClickable = false;
                                    }
                                    else
                                    {
                                        btnClass = "btn-light text-muted border disabled";
                                        labelText = "Đã đặt";
                                        isClickable = false;
                                    }

                                    <div class="col-6 col-sm-4">
                                        <button type="button"
                                                id="slot-btn-@slot.SlotId"
                                                class="btn w-100 py-2 slot-btn @btnClass"
                                                data-slot-id="@slot.SlotId"
                                                data-time="@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")"
                                            @(isClickable ? "" : "disabled")
                                                onclick="selectSlot(this, @slot.SlotId, '@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")')">
                                            <div class="fw-bold">@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</div>
                                            <small class="slot-status-label d-block">@labelText</small>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Ca Chiều -->
            <div class="col-md-6">
                <div class="card border-1 h-100">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="fw-bold text-primary mb-0">Ca Chiều (13:00 - 17:00)</h5>
                    </div>
                    <div class="card-body pt-0">
                        @if (Model.AfternoonSlots.Count == 0)
                        {
                            <p class="text-muted small py-2">Không có ca khám buổi chiều trong ngày này.</p>
                        }
                        else
                        {
                            <div class="row g-2">
                                @foreach (var slot in Model.AfternoonSlots)
                                {
                                    bool isCurrentSlot = slot.SlotId == Model.CurrentSlotId && Model.SelectedDate.Date == Model.CurrentAppointmentDate.Date;
                                    string btnClass;
                                    string labelText;
                                    bool isClickable;

                                    if (isCurrentSlot)
                                    {
                                        btnClass = "btn-outline-info disabled";
                                        labelText = "Slot hiện tại";
                                        isClickable = false;
                                    }
                                    else if (slot.Status == "Open")
                                    {
                                        btnClass = "btn-outline-success";
                                        labelText = "Còn trống";
                                        isClickable = true;
                                    }
                                    else if (slot.Status == "Hold")
                                    {
                                        btnClass = "btn-light text-muted border disabled";
                                        labelText = "Đang giữ";
                                        isClickable = false;
                                    }
                                    else
                                    {
                                        btnClass = "btn-light text-muted border disabled";
                                        labelText = "Đã đặt";
                                        isClickable = false;
                                    }

                                    <div class="col-6 col-sm-4">
                                        <button type="button"
                                                id="slot-btn-@slot.SlotId"
                                                class="btn w-100 py-2 slot-btn @btnClass"
                                                data-slot-id="@slot.SlotId"
                                                data-time="@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")"
                                            @(isClickable ? "" : "disabled")
                                                onclick="selectSlot(this, @slot.SlotId, '@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")')">
                                            <div class="fw-bold">@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</div>
                                            <small class="slot-status-label d-block">@labelText</small>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-1 bg-light p-3 sticky-bottom mb-4 mt-4 shadow-sm">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <span class="text-muted small">Khung giờ mới:</span>
                    <strong class="text-primary fs-6 ms-1" id="selectedSlotText">Chưa chọn</strong>
                    <span class="text-muted small ms-1">(@Model.SelectedDate.ToString("dd/MM/yyyy"))</span>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="MyAppointments" class="btn btn-sm btn-light border">Quay lại</a>
                    <button type="submit" class="btn btn-sm btn-primary px-4 fw-semibold" id="confirmRescheduleBtn" disabled>
                        Xác nhận đổi lịch
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function selectSlot(button, slotId, timeText) {
            document.querySelectorAll('.slot-btn').forEach(btn => {
                if (!btn.disabled && !btn.classList.contains('btn-outline-info')) {
                    btn.classList.remove('btn-success', 'text-white');
                    btn.classList.add('btn-outline-success');
                }
            });

            button.classList.remove('btn-outline-success');
            button.classList.add('btn-success', 'text-white');

            document.getElementById('selectedNewSlotId').value = slotId;
            document.getElementById('selectedSlotText').innerText = timeText;
            document.getElementById('confirmRescheduleBtn').removeAttribute('disabled');
        }
    </script>
}
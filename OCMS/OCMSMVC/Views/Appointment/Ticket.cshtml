@model OCMSMVC.Models.AppointmentDetailViewModel
@{
    ViewData["Title"] = "Phiếu Khám Bệnh Điện Tử - #" + Model.AppointmentId;
    string qrImageUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=180x180&data={Model.QrCodeToken}";
}

<div class="container py-4" style="max-width: 750px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="MyAppointments" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách lịch hẹn
        </a>
        <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> In phiếu khám
        </button>
    </div>

    <div class="card border-1 rounded-4 overflow-hidden shadow-sm mb-4" id="printableTicket">
        <div class="card-header bg-primary text-white p-3 text-center">
            <h5 class="mb-0 fw-bold">PHÒNG KHÁM ĐA KHOA OCMS</h5>
            <small class="opacity-75">Phiếu Đặt Khám & Vé Vào Cửa Điện Tử</small>
        </div>
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-4 text-center border-end-md pb-3 pb-md-0">
                    <img src="@qrImageUrl" alt="Mã QR Vé Khám" class="img-fluid rounded border p-2 bg-white shadow-sm" style="max-width: 170px;" />
                    <div class="mt-2 small fw-bold text-muted font-monospace">@Model.QrCodeToken</div>
                    @if (Model.QueueNumber.HasValue)
                    {
                        <div class="badge bg-success fs-6 mt-2 px-3 py-1">Số thứ tự: #@Model.QueueNumber.Value</div>
                    }
                    <small class="text-primary d-block mt-2">
                        <i class="bi bi-qr-code-scan me-1"></i>Xuất trình mã này tại quầy lễ tân
                    </small>
                </div>

                <div class="col-md-8 ps-md-4">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <span class="text-muted small">Mã lịch hẹn: <strong class="text-dark">#@Model.AppointmentId</strong></span>
                        <span class="badge @(Model.Status == "Confirmed" ? "bg-success" : Model.Status == "Cancelled" ? "bg-danger" : "bg-primary") px-2 py-1">
                            @Model.Status
                        </span>
                    </div>

                    <div class="mb-2">
                        <small class="text-muted d-block">Bệnh nhân:</small>
                        <strong class="fs-6">@Model.PatientName</strong>
                        @if (!string.IsNullOrEmpty(Model.PatientPhone))
                        {
                            <span class="text-muted"> - @Model.PatientPhone</span>
                        }
                    </div>

                    <div class="mb-2">
                        <small class="text-muted d-block">Bác sĩ phụ trách:</small>
                        <strong class="text-primary fs-6">@Model.AcademicTitle @Model.DoctorName</strong>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <small class="text-muted d-block">Chuyên khoa:</small>
                            <strong>@Model.DepartmentName</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Phòng khám:</small>
                            <span class="badge bg-secondary">Phòng @Model.RoomNumber</span>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <small class="text-muted d-block">Ngày khám:</small>
                            <strong>@Model.AppointmentDate.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Khung giờ:</small>
                            <span class="badge bg-success">@Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Reason))
                    {
                        <div class="mb-2">
                            <small class="text-muted d-block">Triệu chứng ban đầu:</small>
                            <span class="text-secondary small fst-italic">@Model.Reason</span>
                        </div>
                    }

                    @if (Model.Status == "Cancelled" && !string.IsNullOrEmpty(Model.CancellationReason))
                    {
                        <div class="mb-2 p-2 bg-danger-subtle rounded border border-danger-subtle small text-danger">
                            <strong>Lý do hủy lịch:</strong> @Model.CancellationReason
                        </div>
                    }

                    <hr class="my-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">Phí khám:</small>
                        <span class="fw-bold text-danger fs-6">@Model.ConsultationFee.ToString("N0") VNĐ</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light p-3 small text-muted text-center">
            <i class="bi bi-info-circle me-1"></i> Quý khách vui lòng có mặt trước giờ hẹn <strong>15 phút</strong> để đo sinh hiệu và hoàn tất thủ tục khám tại Quầy tiếp đón.
        </div>
    </div>
</div>
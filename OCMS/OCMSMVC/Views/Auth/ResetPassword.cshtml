@model OCMSMVC.Models.ResetPasswordViewModel
@{
	ViewData["Title"] = "Thiết lập mật khẩu mới";
}

<div class="row justify-content-center mt-4">
	<div class="col-md-5">
		<div class="card shadow-sm border-0 rounded-3">
			<div class="card-header bg-primary text-white text-center py-3">
				<h4 class="mb-0 fw-bold"><i class="bi bi-key-fill me-2"></i>Đặt lại mật khẩu mới</h4>
				<small class="text-white-50">Nhập mã OTP và tạo mật khẩu mới an toàn</small>
			</div>
			<div class="card-body p-4">
				@if (TempData["InfoMessage"] != null)
				{
					<div class="alert alert-info alert-dismissible fade show" role="alert">
						<i class="bi bi-info-circle-fill me-2"></i>@TempData["InfoMessage"]
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				}

				@if (TempData["DemoOtp"] != null)
				{
					<div class="alert alert-warning border-warning" role="alert">
						<div class="fw-bold mb-1"><i class=" text-warning me-1"></i>Mã OTP (Demo):</div>
						<div class="d-flex align-items-center justify-content-between mt-2">
							<span class="fs-4 fw-bold font-monospace text-primary" id="demoOtpText">@TempData["DemoOtp"]</span>
							<button type="button" class="btn btn-sm btn-outline-primary" onclick="copyOtp()">
								<i class="bi bi-clipboard me-1"></i>Điền tự động
							</button>
						</div>
						<small class="text-muted d-block mt-1">* Mã OTP demo.</small>
					</div>
				}

				@if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
				{
					<div class="alert alert-danger" role="alert">
						<i class="bi bi-exclamation-triangle-fill me-2"></i>
						@Html.ValidationSummary(true, "")
					</div>
				}

				<form asp-action="ResetPassword" method="post">
					<div class="mb-3">
						<label asp-for="Email" class="form-label fw-semibold">Địa chỉ Email</label>
						<div class="input-group">
							<span class="input-group-text"><i class="bi bi-envelope"></i></span>
							<input asp-for="Email" class="form-control" readonly />
						</div>
						<span asp-validation-for="Email" class="text-danger small"></span>
					</div>

					<div class="mb-3">
						<label asp-for="OtpCode" class="form-label fw-semibold">Mã xác thực OTP (6 số)</label>
						<div class="input-group">
							<span class="input-group-text"><i class="bi bi-shield-check"></i></span>
							<input asp-for="OtpCode" class="form-control font-monospace fs-5 fw-bold text-center" id="otpInput" maxlength="6" placeholder="000000" autofocus />
						</div>
						<span asp-validation-for="OtpCode" class="text-danger small"></span>
					</div>

					<div class="mb-3">
						<label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
						<div class="input-group">
							<span class="input-group-text"><i class="bi bi-lock"></i></span>
							<input asp-for="NewPassword" class="form-control" placeholder="••••••••" />
						</div>
						<span asp-validation-for="NewPassword" class="text-danger small"></span>
					</div>

					<div class="mb-3">
						<label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
						<div class="input-group">
							<span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
							<input asp-for="ConfirmNewPassword" class="form-control" placeholder="••••••••" />
						</div>
						<span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
					</div>

					<div class="d-grid mb-3">
						<button type="submit" class="btn btn-primary btn-lg fw-bold">
							<i class="bi bi-check2-circle me-1"></i> Xác nhận đổi mật khẩu
						</button>
					</div>

					<div class="text-center">
						<a asp-action="Login" class="text-decoration-none small text-muted">
							<i class="bi bi-arrow-left me-1"></i> Hủy bỏ và quay lại Đăng nhập
						</a>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script>
		function copyOtp() {
			var otpVal = document.getElementById('demoOtpText')?.innerText;
			if (otpVal) {
				document.getElementById('otpInput').value = otpVal.trim();
			}
		}
	</script>
}
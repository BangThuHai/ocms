@model OCMSMVC.Models.ETicketViewModel
@{
    ViewData["Title"] = "Vé khám điện tử";
    var appointment = Model.Appointment;
}

<div class="row justify-content-center py-5"><div class="col-md-7 col-lg-5">
    <div class="card border-0 shadow-sm text-center ticket-card">
        <div class="card-body p-4 p-md-5">
            <div class="text-primary fw-bold fs-4">OCMS CLINIC</div>
            <div class="text-uppercase small text-muted mb-4">Vé khám điện tử</div>
            <div id="ticketQr" class="d-flex justify-content-center mb-3"></div>
            <div class="text-muted small">Mã lượt khám</div><div class="fs-4 fw-bold mb-4">#@appointment.Id</div>
            <div class="text-start border-top pt-3">
                <div class="mb-2"><span class="text-muted">Bệnh nhân:</span> @appointment.Patient.User.FullName</div>
                <div class="mb-2"><span class="text-muted">Bác sĩ:</span> @appointment.Doctor.AcademicTitle @appointment.Doctor.User.FullName</div>
                <div><span class="text-muted">Thời gian:</span> @appointment.AppointmentDate.AddHours(7).ToString("dd/MM/yyyy HH:mm") (GMT+7)</div>
            </div>
            <code id="ticketToken" class="d-none">@appointment.QrCodeToken</code>
            <p class="small text-muted mt-4 mb-0">Vui lòng xuất trình mã QR này tại quầy tiếp đón.</p>
        </div>
    </div>
</div></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>
    <script>
        QRCode.toCanvas(document.createElement('canvas'), document.getElementById('ticketToken').textContent.trim(), { width: 220 }, function (error, canvas) {
            if (!error) document.getElementById('ticketQr').appendChild(canvas);
        });
    </script>
}

<style>
    @@media print { header, footer { display: none !important; } .container { max-width: 100% !important; } .ticket-card { border: 0 !important; box-shadow: none !important; } }
</style>

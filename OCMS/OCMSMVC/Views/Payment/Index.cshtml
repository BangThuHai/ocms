@model IReadOnlyList<OCMSMVC.Models.PatientDepositAppointmentViewModel>

@{
    ViewData["Title"] = "Đặt cọc lịch khám";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3">Lịch hẹn chờ đặt cọc</h1>
        <p class="text-muted mb-0">
            Chọn lịch hẹn để thanh toán phí khám qua VNPAY.
        </p>
    </div>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Bạn hiện không có lịch hẹn nào đang chờ đặt cọc.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                var appointment = item.Appointment;

                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex flex-column flex-md-row
                                        justify-content-between gap-3">
                                <div>
                                    <div class="text-muted small">
                                        Mã lịch hẹn #@appointment.Id
                                    </div>

                                    <h2 class="h5 mt-1 mb-2">
                                        @appointment.Doctor.AcademicTitle
                                        @appointment.Doctor.User.FullName
                                    </h2>

                                    <div class="mb-1">
                                        <strong>Khoa:</strong>
                                        @appointment.Doctor.Department.Name
                                    </div>

                                    <div class="mb-1">
                                        <strong>Thời gian:</strong>
                                        @(appointment.AppointmentDate.AddHours(7).ToString("dd/MM/yyyy HH:mm"))
                                        (GMT+7)
                                    </div>

                                    <div>
                                        <strong>Trạng thái:</strong>
                                        Đang giữ chỗ, chờ đặt cọc
                                    </div>
                                </div>

                                <div class="text-md-end">
                                    <div class="text-muted small">
                                        Phí đặt cọc
                                    </div>

                                    <div class="fs-4 fw-bold text-primary mb-3">
                                        @item.Amount.ToString("N0") ₫
                                    </div>

                                    <form asp-controller="Payment"
                                          asp-action="Deposit"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="appointmentId"
                                               value="@appointment.Id" />

                                        <button type="submit"
                                                class="btn btn-primary">
                                            <i class="bi bi-qr-code me-1"></i>
                                            @(item.HasPendingDeposit
                                                ? "Tiếp tục thanh toán"
                                                : "Đặt cọc qua VNPAY")
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

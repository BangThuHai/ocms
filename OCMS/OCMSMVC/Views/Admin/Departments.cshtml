@model OCMSMVC.Models.AdminDepartmentViewModel
@using BusinessObjects.Entities
@{ ViewData["Title"] = "Quản lý khoa"; var departments = (IReadOnlyList<Department>)ViewBag.Departments; }
<a asp-action="Index" class="text-decoration-none">← Quản trị</a><h1 class="h3 mt-2 mb-3">Khoa khám</h1>
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> } @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">@(Model.Id == 0 ? "Thêm khoa" : "Sửa khoa")</h2><form asp-action="SaveDepartment" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-2"><label asp-for="Code" class="form-label">Mã khoa</label><input asp-for="Code" class="form-control" /></div><div class="col-md-4"><label asp-for="Name" class="form-label">Tên khoa</label><input asp-for="Name" class="form-control" /></div><div class="col-md-3"><label asp-for="BaseConsultationFee" class="form-label">Phí khám cơ bản</label><input asp-for="BaseConsultationFee" class="form-control" type="number" min="0" /></div><div class="col-md-3"><label asp-for="Description" class="form-label">Mô tả</label><input asp-for="Description" class="form-control" /></div></div><button class="btn btn-primary mt-3">Lưu khoa</button>@if (Model.Id != 0) { <a asp-action="Departments" class="btn btn-outline-secondary mt-3">Hủy sửa</a> }</form></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Mã</th><th>Tên khoa</th><th>Phí khám</th><th>Bác sĩ</th><th>Phòng</th><th></th></tr></thead><tbody>@foreach (var d in departments) { <tr><td>@d.Code</td><td>@d.Name<br /><small class="text-muted">@d.Description</small></td><td>@d.BaseConsultationFee.ToString("N0") đ</td><td>@d.Doctors.Count</td><td>@d.Rooms.Count</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Departments" asp-route-id="@d.Id">Sửa</a> <form asp-action="DeleteDepartment" method="post" class="d-inline" onsubmit="return confirm('Xóa khoa này? Chỉ xóa được khi chưa được tài khoản, phòng hoặc dịch vụ sử dụng.')"><input type="hidden" name="id" value="@d.Id" /><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr> }</tbody></table></div></div>

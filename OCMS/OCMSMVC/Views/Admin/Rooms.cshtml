@model OCMSMVC.Models.AdminRoomViewModel
@using BusinessObjects.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@{ ViewData["Title"] = "Quản lý phòng"; var rooms = (IReadOnlyList<Room>)ViewBag.Rooms; }
<a asp-action="Index" class="text-decoration-none">← Quản trị</a><h1 class="h3 mt-2 mb-3">Phòng khám</h1>
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> } @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">@(Model.Id == 0 ? "Thêm phòng" : "Sửa phòng")</h2><form asp-action="SaveRoom" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-3"><label asp-for="RoomNumber" class="form-label">Số phòng</label><input asp-for="RoomNumber" class="form-control" /></div><div class="col-md-4"><label asp-for="DepartmentId" class="form-label">Khoa</label><select asp-for="DepartmentId" class="form-select"><option value="">-- Chọn khoa --</option>@foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.DepartmentOptions) { <option value="@item.Value">@item.Text</option> }</select></div><div class="col-md-3"><label asp-for="RoomType" class="form-label">Loại phòng</label><input asp-for="RoomType" class="form-control" /></div><div class="col-md-2 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="IsOperational" class="form-check-input" /><label asp-for="IsOperational" class="form-check-label">Đang hoạt động</label></div></div></div><button class="btn btn-primary mt-3">Lưu phòng</button>@if (Model.Id != 0) { <a asp-action="Rooms" class="btn btn-outline-secondary mt-3">Hủy sửa</a> }</form></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Số phòng</th><th>Khoa</th><th>Loại</th><th>Trạng thái</th><th>Lịch</th><th></th></tr></thead><tbody>@foreach (var r in rooms) { <tr><td>@r.RoomNumber</td><td>@r.Department.Name</td><td>@r.RoomType</td><td>@(r.IsOperational ? "Hoạt động" : "Tạm ngưng")</td><td>@r.Schedules.Count</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Rooms" asp-route-id="@r.Id">Sửa</a> <form asp-action="DeleteRoom" method="post" class="d-inline" onsubmit="return confirm('Xóa phòng này? Chỉ xóa được khi chưa có bác sĩ hoặc lịch được gán.')"><input type="hidden" name="id" value="@r.Id" /><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr> }</tbody></table></div></div>
